{
  "name": "persona-palace-explorer",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n site,api -c red,white \"vite\" \"tsx watch server/index.js\"",
    "dev:site": "vite",
    "dev:api": "tsx watch server/index.js",
    "build": "vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "postinstall": "prisma generate",
    "db:setup": "prisma migrate reset --force && prisma generate && prisma db seed",
    "db:studio": "prisma studio --port 5555 --url file://./prisma/dev.db",
    "db:export": "tsx prisma/export.js",
    "db:seed": "prisma db seed"
  },
  "dependencies": {
    "@fontsource/anton": "^5.3.0",
    "@fontsource/oswald": "^5.3.0",
    "@gsap/react": "^2.1.2",
    "@prisma/adapter-libsql": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "express": "^5.2.1",
    "gsap": "^3.15.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "concurrently": "^10.0.5",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.6",
    "globals": "^17.12.0",
    "prisma": "^7.10.0",
    "tsx": "^4.23.15",
    "vite": "^8.3.0"
  }
}
